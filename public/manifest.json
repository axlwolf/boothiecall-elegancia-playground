{
  "name": "BoothieCall Elegancia Playground",
  "short_name": "BoothieCall",
  "description": "A sophisticated web-based photobooth application with luxury dark aesthetics and gold accents",
  "start_url": "/playground/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#D8AE48",
  "orientation": "portrait-primary",
  "scope": "/playground/",
  "lang": "en",
  "categories": ["photo", "entertainment", "productivity"],
  "screenshots": [
    {
      "src": "screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Main photobooth interface on desktop"
    },
    {
      "src": "screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Mobile photobooth experience"
    }
  ],
  "icons": [
