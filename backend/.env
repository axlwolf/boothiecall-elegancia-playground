# Database Configuration
DATABASE_URL="postgresql://boothiecall:dev_password_2024@localhost:5432/boothiecall_dev"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="boothiecall_dev"
DB_USER="boothiecall"
DB_PASS="dev_password_2024"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT Configuration
JWT_SECRET="dev_jwt_secret_key_2024_boothiecall"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_key_2024_boothiecall"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# MinIO S3 Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="boothiecall"
MINIO_SECRET_KEY="dev_password_2024"
MINIO_USE_SSL="false"
MINIO_BUCKET_NAME="boothiecall-assets"

# Server Configuration
NODE_ENV="development"
PORT="3001"
API_VERSION="v1"
API_PREFIX="/api/v1"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
CORS_CREDENTIALS="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# File Upload Configuration
MAX_FILE_SIZE="10485760"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp"

# Logging Configuration
LOG_LEVEL="debug"
LOG_FILE="logs/app.log"

# Security Configuration
BCRYPT_ROUNDS="12"
SESSION_SECRET="dev_session_secret_2024_boothiecall"

# Multi-tenant Configuration
DEFAULT_TENANT_ID="default"
TENANT_HEADER="x-tenant-id"

# Background Jobs Configuration
QUEUE_REDIS_URL="redis://localhost:6379"
QUEUE_NAME="boothiecall-jobs"

# Monitoring Configuration
HEALTH_CHECK_INTERVAL="30000"
METRICS_ENABLED="true"

# Development Configuration
DEV_SEED_DATA="true"
DEV_AUTO_MIGRATE="true"
DEV_LOG_SQL="false"
