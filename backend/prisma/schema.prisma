// Prisma Schema for BoothieCall Backend
// Supports both PostgreSQL (development) and MySQL (GoDaddy production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // Change to "postgresql" for local development
  url      = env("DATABASE_URL")
}

// Tenant model for multi-tenancy
model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  subdomain   String   @unique
  settings    Json?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  assets      Asset[]
  filters     Filter[]
  sessions    PhotoSession[]
  analytics   Analytics[]

  @@map("tenants")
}

// User model with role-based access control
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  username    String?
  firstName   String?
  lastName    String?
  password    String
  role        UserRole @default(VIEWER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant relation
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Relations
  sessions    PhotoSession[]
  createdAssets Asset[] @relation("AssetCreator")
  createdFilters Filter[] @relation("FilterCreator")

  @@map("users")
}

// User roles enum
enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  EDITOR
  VIEWER
}

// Asset model for managing uploaded files
model Asset {
  id          String    @id @default(cuid())
  filename    String
  originalName String
  mimeType    String
  size        Int
  path        String
  url         String?
  type        AssetType
  category    String?
  metadata    Json?
  version     Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Multi-tenant relation
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Creator relation
  createdById String
  createdBy   User      @relation("AssetCreator", fields: [createdById], references: [id])

  // Relations
  sessions    PhotoSession[]

  @@map("assets")
}

// Asset types enum
enum AssetType {
  LOGO
  BACKGROUND
  TEMPLATE
  FRAME
  WATERMARK
  OTHER
}

// Filter model for photo effects
model Filter {
  id          String      @id @default(cuid())
  name        String
  displayName String
  description String?
  category    String
  cssFilter   String
  settings    Json?
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Multi-tenant relation
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Creator relation
  createdById String
  createdBy   User        @relation("FilterCreator", fields: [createdById], references: [id])

  // Relations
  sessionFilters SessionFilter[]

  @@map("filters")
}

// Photo session model
model PhotoSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  layout      String    // "1", "3", "4", "6"
  template    String?
  status      SessionStatus @default(ACTIVE)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Multi-tenant relation
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // User relation (optional for anonymous sessions)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  // Asset relation (background/template)
  assetId     String?
  asset       Asset?    @relation(fields: [assetId], references: [id])

  // Relations
  photos      Photo[]
  filters     SessionFilter[]
  outputs     SessionOutput[]

  @@map("photo_sessions")
}

// Session status enum
enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// Photo model for individual photos in a session
model Photo {
  id          String   @id @default(cuid())
  filename    String
  originalName String?
  path        String
  url         String?
  position    Int      // Position in the layout (0, 1, 2, etc.)
  metadata    Json?
  createdAt   DateTime @default(now())

  // Session relation
  sessionId   String
  session     PhotoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("photos")
}

// Session filter junction table
model SessionFilter {
  id        String @id @default(cuid())
  photoPosition Int? // null means applied to all photos
  settings  Json?
  createdAt DateTime @default(now())

  // Relations
  sessionId String
  session   PhotoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  filterId  String
  filter    Filter @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@unique([sessionId, filterId, photoPosition])
  @@map("session_filters")
}

// Session output model (final generated images/GIFs)
model SessionOutput {
  id          String     @id @default(cuid())
  filename    String
  path        String
  url         String?
  format      OutputFormat
  size        Int
  metadata    Json?
  createdAt   DateTime   @default(now())

  // Session relation
  sessionId   String
  session     PhotoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_outputs")
}

// Output format enum
enum OutputFormat {
  PNG
  JPEG
  GIF
  PDF
}

// Analytics model for tracking usage
model Analytics {
  id          String   @id @default(cuid())
  event       String   // "session_created", "photo_taken", "filter_applied", etc.
  data        Json?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  // Multi-tenant relation
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("analytics")
}
