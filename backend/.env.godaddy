# GoDaddy Production Configuration
# Copy this to .env when deploying to GoDaddy

# Database Configuration (MySQL on GoDaddy)
DATABASE_URL="mysql://username:password@localhost:3306/database_name"
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="your_database_name"
DB_USER="your_database_user"
DB_PASS="your_database_password"

# No Redis on shared hosting - using in-memory cache
REDIS_URL=""
REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""

# JWT Configuration (use strong secrets in production)
JWT_SECRET="your_super_secure_jwt_secret_key_here_minimum_32_characters"
JWT_REFRESH_SECRET="your_super_secure_refresh_secret_key_here_minimum_32_characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# No MinIO on shared hosting - using local filesystem
MINIO_ENDPOINT=""
MINIO_PORT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_USE_SSL="false"
MINIO_BUCKET_NAME=""

# Server Configuration
NODE_ENV="production"
PORT="3000"
API_VERSION="v1"
API_PREFIX="/api/v1"

# CORS Configuration (update with your domain)
CORS_ORIGIN="https://yourdomain.com,https://www.yourdomain.com"
CORS_CREDENTIALS="true"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"

# File Upload Configuration
MAX_FILE_SIZE="5242880"
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp"

# Logging Configuration
LOG_LEVEL="warn"
LOG_FILE="logs/app.log"

# Security Configuration
BCRYPT_ROUNDS="12"
SESSION_SECRET="your_super_secure_session_secret_key_here_minimum_32_characters"

# Multi-tenant Configuration
DEFAULT_TENANT_ID="default"
TENANT_HEADER="x-tenant-id"

# Background Jobs Configuration (disabled on shared hosting)
QUEUE_REDIS_URL=""
QUEUE_NAME=""

# Monitoring Configuration
HEALTH_CHECK_INTERVAL="60000"
METRICS_ENABLED="false"

# Production Configuration
DEV_SEED_DATA="false"
DEV_AUTO_MIGRATE="false"
DEV_LOG_SQL="false"
