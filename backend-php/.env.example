# BoothieCall Elegancia API - PHP Environment Configuration

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City

# Database Configuration (MySQL for GoDaddy)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=boothiecall_dev
DB_USER=root
DB_PASS=password

# JWT Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_minimum_32_characters
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp
UPLOAD_PATH=uploads
TEMP_PATH=temp

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging Configuration
LOG_LEVEL=debug
LOG_PATH=logs/app.log
LOG_MAX_FILES=7

# Security Configuration
BCRYPT_COST=12
SESSION_NAME=boothiecall_session
SESSION_LIFETIME=3600

# Multi-tenant Configuration
DEFAULT_TENANT_ID=default
TENANT_HEADER=X-Tenant-ID
MULTI_TENANT_ENABLED=true

# Image Processing Configuration
IMAGE_DRIVER=gd
IMAGE_QUALITY=85
IMAGE_MAX_WIDTH=2048
IMAGE_MAX_HEIGHT=2048
THUMBNAIL_SIZE=300

# Cache Configuration
CACHE_ENABLED=true
CACHE_DRIVER=file
CACHE_PATH=cache
CACHE_TTL=3600

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1
API_DEFAULT_LIMIT=20
API_MAX_LIMIT=100
