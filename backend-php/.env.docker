APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug

# Database
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boothiecall
DB_USERNAME=boothiecall
DB_PASSWORD=boothiecall_password



# JWT
JWT_SECRET=docker_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=docker_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=604800

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000