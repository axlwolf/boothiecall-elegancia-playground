{
    "name": "boothiecall/elegancia-api",
    "description": "BoothieCall Elegancia Playground - PHP REST API for GoDaddy hosting",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Axel Lanuza",
            "email": "axel@boothiecall.net"
        }
    ],
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "firebase/php-jwt": "^6.8",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^3.4",
        "respect/validation": "^2.2",
        "intervention/image": "^2.7",
        "league/flysystem": "^3.15",
        "ramsey/uuid": "^4.7",
        "tuupola/cors-middleware": "^1.4",
        "selective/basepath": "^2.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "BoothieCall\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BoothieCall\\Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "analyze": "phpstan analyze src --level=8",
        "dev": "php -S localhost:8080 -t public",
        "install-dev": "composer install --dev",
        "install-prod": "composer install --no-dev --optimize-autoloader"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
